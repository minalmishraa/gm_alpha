generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("PUBLIC") // ADMIN, DRIVER, PUBLIC
  photo     String?
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver      Driver?
  notifications Notification[]
}

model Driver {
  id             String   @id @default(cuid())
  userId         String   @unique
  vehicleNumber  String
  vehicleType    String   // AMBULANCE, FIRE_BRIGADE, POLICE, DISASTER_RESPONSE
  licenseNumber  String
  verified       Boolean  @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  online         Boolean  @default(false)
  activeEmergency Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencies Emergency[]
}

model Board {
  id              String   @id @default(cuid())
  boardName       String
  latitude        Float
  longitude       Float
  address         String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  lastHeartbeat   DateTime @default(now())
  displayMessage  String?
  eta             Int?
  direction       String?
  radius          Int      @default(500) // meters
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Emergency {
  id                  String    @id @default(cuid())
  driverId            String
  vehicleType         String
  destinationName     String
  destinationLatitude  Float
  destinationLongitude Float
  route               String?   // JSON polyline points
  currentLatitude     Float?
  currentLongitude    Float?
  speed               Float?    // km/h
  distanceRemaining   Float?    // km
  eta                 Int?      // seconds
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  status              String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  driver Driver @relation(fields: [driverId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  receiverId String
  title     String
  body      String
  type      String?   // ALERT, INFO, WARNING
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  user User @relation(fields: [receiverId], references: [id], onDelete: Cascade)
}

model Hospital {
  id      String  @id @default(cuid())
  name    String
  latitude Float
  longitude Float
  beds    Int     @default(0)
  contact String?
  address String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String   // EMERGENCY_STARTED, EMERGENCY_ENDED, BOARD_TRIGGERED, USER_NOTIFIED
  data      String?  // JSON
  timestamp DateTime @default(now())
}
